{
  "version": "2.0",
  "principle": "只收人在正常观看时能明显看出来的问题。看不出来的差异不算错误。",
  "groups": {
    "A": { "name": "与创意要求不一致", "question": "成片是否做到了创意要求里写明的内容？" },
