  },
  "categories": {
    "A1": { "group": "A", "name": "产品不一致", "examples": ["耳机没有要求的柄", "杯盖多了提环", "产品颜色变了", "多出或少了部件", "Logo 不对"] },
    "A2": { "group": "A", "name": "动作方式不符", "examples": ["要求滑开却直接掀开", "要求拧开却变成拧上", "要求的动作没有完成"] },
    "A3": { "group": "A", "name": "交互对象不符", "examples": ["要求按琴键却摸琴身", "要求按电源键却按了别的键"] },
    "A4": { "group": "A", "name": "使用方法不符", "examples": ["要求喷在手腕却喷向空中", "要求涂在脸上却涂在手背"] },
    "A5": { "group": "A", "name": "氛围情绪不符", "examples": ["要求轻松愉快，成片清冷惨淡"] },
    "A6": { "group": "A", "name": "场景环境不符", "examples": ["要求户外公园，成片在室内健身房"] },
    "A7": { "group": "A", "name": "文案字幕不符", "examples": ["字幕写 50W，要求是 15W"] },
    "B1": { "group": "B", "name": "物理或因果不合理", "examples": ["水往上流", "水倒进去杯子却不满", "没按键灯自己亮了"] },
    "B2": { "group": "B", "name": "画面跳变", "examples": ["瞬移", "物体凭空消失又出现", "状态回到开头", "先出结果再出动作"] },
    "B3": { "group": "B", "name": "技术故障", "examples": ["黑场", "冻帧超过 1 秒", "全片没有声音"] },
